{
  "manifest_version": 3,
  "name": "ConsentZero — Reject Cookie Banners",
  "short_name": "ConsentZero",
  "description": "100% local privacy-first cookie banner auto-rejector with zero telemetry, zero idle CPU, and a transparent per-site audit log.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ConsentZero",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
